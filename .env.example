# AgriShield AI Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection URI (Optional - graceful in-memory/JSON fallback included if not running)
MONGODB_URI=mongodb://localhost:27017/agrishield_ai

# Ollama Vision AI Configuration (Local / Demonstration Mode)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b

# AI Provider Configuration
# AI_PROVIDER can be 'ollama', 'qwen', 'gemini', 'openai', or 'demo' (dual-engine rule fallback)
AI_PROVIDER=ollama
AI_API_KEY=
AI_API_URL=

# Weather API Configuration
# Open-Meteo is default & requires no key.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# JWT Secret for farmer sessions
JWT_SECRET=agrishield_ai_secure_jwt_secret_2026_sih

# Client URL for CORS
CLIENT_URL=http://localhost:5173
