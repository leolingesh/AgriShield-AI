# AgriShield AI Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection URI (Optional - graceful in-memory/JSON fallback included if not running)
MONGODB_URI=mongodb://localhost:27017/agrishield_ai

# AI Service Configuration
# AI_PROVIDER can be 'qwen', 'gemini', 'openai', or 'demo' (default fallback rule-engine)
AI_PROVIDER=demo
AI_API_KEY=your_ai_api_key_here
AI_API_URL=https://api.example.com/v1

# Weather API Configuration
# Open-Meteo is default & requires no key. OpenWeatherMap is also supported.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=your_openweather_key_here

# JWT Secret for farmer sessions
JWT_SECRET=agrishield_ai_secure_jwt_secret_2026_sih

# Client URL for CORS
CLIENT_URL=http://localhost:5173
